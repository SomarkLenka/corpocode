# CorpoCode reads provider keys from ~/.corpocode/secrets (chmod 600) OR from these conventional
# environment variables. Copy to .env for local development if your runner loads dotenv; CorpoCode
# itself reads process.env directly.

# Provider API keys (only the ones you use). anthropic-cli and ollama need no key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override any config field via a flat CORPOCODE_* variable, e.g.
# CORPOCODE_PROVIDERS_DEFAULT_MODEL=claude-haiku-4-5-20251001
# CORPOCODE_LOGGING_ENABLED=false

# Optional: relocate all CorpoCode state (config, logs, memory) — used by tests.
# CORPOCODE_HOME=

# Set to 1 to print fail-open hook errors (with stack) to stderr.
# CORPOCODE_DEBUG=1
